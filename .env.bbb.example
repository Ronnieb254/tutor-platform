# BigBlueButton Configuration
# Replace Jitsi with BigBlueButton for video conferencing

# BBB Server URL (without /api/ suffix)
BBB_SERVER_URL=https://bbb.mwalimu.co.ke/bigbluebutton

# BBB Shared Secret (get this from your BBB server)
# Run on your BBB server: sudo bbb-conf --secret
BBB_SECRET=your_bbb_shared_secret_here

# Optional: BBB Server Name
BBB_SERVER_NAME="Mwalimu Learning Platform"
